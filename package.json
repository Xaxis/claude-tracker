{
  "name": "claude-tracker",
  "version": "1.0.0",
  "description": "Local dashboard that tracks Claude usage, sessions, and rate-limit windows across multiple accounts.",
  "type": "module",
  "bin": {
    "claude-tracker": "./bin/cli.js"
  },
  "scripts": {
    "start": "node bin/cli.js serve --open",
    "serve": "node bin/cli.js serve",
    "tui": "node bin/cli.js tui",
    "web": "node bin/cli.js serve --no-tui --open",
    "status": "node bin/cli.js status",
    "ingest": "node bin/cli.js ingest",
    "models": "node bin/cli.js models",
    "accounts": "node bin/cli.js accounts",
    "verify": "node bin/cli.js verify",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "keywords": [
    "claude",
    "claude-code",
    "usage",
    "rate-limit",
    "dashboard"
  ],
  "license": "MIT",
  "dependencies": {}
}
